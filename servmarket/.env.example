# ServMarket Environment Variables
# Copiez ce fichier vers .env et remplacez les valeurs par vos propres clés.
# IMPORTANT : Le fichier .env ne doit JAMAIS être commité sur Git.

# Firebase Configuration
# Les fichiers de configuration Firebase sont gérés via FlutterFire CLI
# - google-services.json (Android) - à obtenir depuis la console Firebase
# - GoogleService-Info.plist (iOS) - à obtenir depuis la console Firebase
# Ces fichiers doivent être placés dans les dossiers appropriés et ajoutés à .gitignore

# Pour obtenir les fichiers Firebase :
# 1. Allez sur https://console.firebase.google.com/
# 2. Sélectionnez votre projet
# 3. Paramètres du projet > Vos applications
# 4. Téléchargez les fichiers de configuration pour Android et iOS
# 5. Placez-les dans les dossiers android/app/ et ios/Runner/
# 6. NE JAMAIS COMMITTER ces fichiers

# Maps / Géocodage (optionnel, si vous utilisez un service externe)
# GOOGLE_MAPS_API_KEY=your_key_here

# Autres clés API futures
# SOME_API_KEY=your_key_here
